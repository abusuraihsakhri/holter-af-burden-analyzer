# Copy this file to .env and set your own values.
# NEVER commit the .env file to version control.

# HMAC-SHA256 audit trail signing key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
AUDIT_SECRET_KEY=your-secure-random-key-here

# LLM provider: mock, ollama, claude, openai
MODEL_PROVIDER=mock
